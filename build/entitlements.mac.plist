<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a hardened-runtime (notarised) Frostline build. Only used when mac.hardenedRuntime is
  switched on for release (see docs/STEAM.md → macOS signing).
  - allow-jit / allow-unsigned-executable-memory: V8 + Chromium GPU process.
  - disable-library-validation: load libsteam_api.dylib + the steamworks.js .node addon (not signed by us).
  - allow-dyld-environment-variables: the Steam client injects its overlay via DYLD_INSERT_LIBRARIES.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
