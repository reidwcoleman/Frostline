{
  "name": "frostline",
  "productName": "Frostline",
  "version": "0.1.0",
  "description": "Frostline — an alpine survival game. Ski, hunt, build, survive.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5317 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5198",
    "shot": "node tools/shot.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "steamworks.js": "^0.4.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
